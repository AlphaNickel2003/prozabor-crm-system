@model IEnumerable<CrmSystem.DTOs.AllDealsResponseDto>

@{
    Layout = "_Layout";
}

<main class="main-content">
    <!-- Раздел "Все задачи" -->
    <section id="section-deals" class="section active">
        <div class="card">
            <h2>Все задачи</h2>
            <table class="deals-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Клиент</th>
                        <th>Телефон</th>
                        <th>Адрес</th>
                    </tr>
                </thead>
                <tbody id="dealsTableBody">
                    <!-- Строки добавляются JavaScript -->
                </tbody>
            </table>
            <div id="dealsEmpty" style="display:none; text-align:center; padding:20px; color:#8ab87a;">Нет задач</div>
        </div>
    </section>

    <!-- Раздел "Задачи" -->
    <section id="section-tasks" class="section">
        <!-- Flex-контейнер для трёх колонок -->
        <div class="tasks-flex">
            <!-- Первая колонка: просрочено + сегодня -->
            <div class="task-column" id="taskColumnToday">
                <div id="taskOverdue" style="display: none;"></div>   <!-- сюда добавится блок просроченных -->
                <div id="taskToday"></div>                           <!-- сюда добавится сегодня -->
            </div>

            <!-- Вторая колонка: завтра -->
            <div class="task-column" id="taskColumnTomorrow">
                <div id="taskTomorrow"></div>
            </div>

            <!-- Третья колонка: неделя -->
            <div class="task-column" id="taskColumnWeek">
                <div id="taskWeek"></div>
            </div>
        </div>

        <!-- Сообщение "Нет задач" -->
        <div id="tasksEmpty" style="display: none; text-align: center; padding: 40px; color: #7a9a7a;">
            Нет задач
        </div>
    </section>
</div>
</main>

<!-- Модалка создания / редактирования -->
<div class="modal-overlay" id="formModalOverlay">
    <div class="modal modal-form">
        <div class="modal-header">
            <h2 id="formModalTitle">Новая заявка</h2>
            <button class="modal-close" id="closeFormModalBtn">&times;</button>
        </div>
        <form id="dealForm">
            <input type="hidden" id="editId" value="0" />
            <div class="form-group">
                <label for="customersName">Имя клиента *</label>
                <input type="text" id="customersName" required maxlength="50" />
            </div>
            <div class="form-group">
                <label for="customersPhoneNumber">Телефон *</label>
                <input type="text" id="customersPhoneNumber" required maxlength="50" />
            </div>
            <div class="form-group">
                <label for="location">Адрес</label>
                <input type="text" id="location" maxlength="200" />
            </div>
            <div class="form-group">
                <label for="description">Описание</label>
                <textarea id="description" maxlength="100" rows="3"></textarea>
            </div>
            <div class="form-group">
                <label for="dateTask">Дата и время задачи *</label>
                <input type="datetime-local" id="dateTask" required />
            </div>
            <button type="submit" class="btn-submit" id="formSubmitBtn">Создать</button>
        </form>
    </div>
</div>

<!-- Модалка деталей -->
<div class="modal-overlay" id="detailsModalOverlay">
    <div class="modal modal-details">
        <div class="modal-header">
            <h2>Детали заявки #<span id="detailId"></span></h2>
            <button class="modal-close" id="closeDetailsModalBtn">&times;</button>
        </div>
        <div class="modal-body">
            <div class="detail-row"><strong>Клиент:</strong> <span id="detailName"></span></div>
            <div class="detail-row"><strong>Телефон:</strong> <span id="detailPhone"></span></div>
            <div class="detail-row"><strong>Адрес:</strong> <span id="detailLocation"></span></div>
            <div class="detail-row"><strong>Описание:</strong> <span id="detailDescription"></span></div>
            <div class="detail-row"><strong>Дата задачи:</strong> <span id="detailDateTask"></span></div>
        </div>
        <div class="modal-footer" style="margin-top: 20px; display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn-edit" id="editDealBtn">Изменить</button>
            <button class="btn-delete" id="deleteDealBtn">Удалить</button>
        </div>
    </div>
</div>

<!-- Модалка подтверждения удаления -->
<div class="modal-overlay" id="confirmModalOverlay">
    <div class="modal modal-confirm">
        <div class="modal-header">
            <h2>Подтверждение удаления</h2>
            <button class="modal-close" id="closeConfirmModalBtn">&times;</button>
        </div>
        <div class="modal-body" style="text-align:center; padding:20px 0;">
            <p style="font-size:18px; color: #d4e8d4;">Вы точно хотите удалить задачу?</p>
        </div>
        <div class="modal-footer" style="display: flex; gap: 12px; justify-content: center;">
            <button class="btn-confirm-yes" id="confirmDeleteYes">Да</button>
            <button class="btn-confirm-no" id="confirmDeleteNo">Нет</button>
        </div>
    </div>
</div>