<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />
    <title>CRM System ProZabor</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Хедер -->
        <header class="header">
            <div class="logo-placeholder"></div>
            <h1>CRM System ProZabor</h1>
        </header>

        <!-- Сайдбар -->
        <aside class="sidebar">
            <nav class="sidebar-nav">
                <button class="sidebar-btn active" data-tab="deals">Все заявки</button>
                <button class="sidebar-btn" data-tab="tasks">Задачи</button>
            </nav>
            <button class="add-btn" id="openModalBtn">+</button>
        </aside>

        <!-- Основное содержимое страницы (вставляется из Index.cshtml) -->
        @RenderBody()
    </div>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>